COMPOSE_PROJECT_NAME=protegid

# Local ports
NGINX_HTTP_PORT=8080
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# App
APP_ENV=local
NEXT_PUBLIC_APP_NAME=ProtegID
# Optional. Leave empty to use same-origin /api routing through Nginx.
NEXT_PUBLIC_API_BASE_URL=
PUBLIC_APP_URL=http://localhost:8080
PUBLIC_PROFILE_PATH=/p

# Email delivery for local verification flows.
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@protegid.local
SMTP_FROM_NAME=ProtegID

# Legacy JWT settings kept for code paths not used by the product web session flow.
JWT_SECRET_KEY=change-me-local-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Secure server-side sessions. In production use HTTPS and:
# SESSION_COOKIE_NAME=__Host-protegid_session
# SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=protegid_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_PATH=/
SESSION_ABSOLUTE_TTL_SECONDS=604800
SESSION_TOKEN_BYTES=32
SESSION_LAST_USED_UPDATE_INTERVAL_SECONDS=300
CSRF_COOKIE_NAME=protegid_csrf
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_TOKEN_BYTES=32

# PostgreSQL local example values. Replace before using outside local development.
POSTGRES_DB=protegid
POSTGRES_USER=protegid_app
POSTGRES_PASSWORD=change-me-local-postgres-password
DATABASE_URL=postgresql://protegid_app:change-me-local-postgres-password@protegid-db:5432/protegid

# Redis
REDIS_URL=redis://protegid-redis:6379/0

# MinIO local example values. Replace before using outside local development.
MINIO_ROOT_USER=protegid_minio
MINIO_ROOT_PASSWORD=change-me-local-minio-password
MINIO_BUCKET=protegid-local
S3_ENDPOINT=http://protegid-minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=protegid_minio
S3_SECRET_ACCESS_KEY=change-me-local-minio-password
